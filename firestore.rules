rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 학생 응답: 읽기·쓰기 가능, 삭제 불가, 형식이 맞는 것만 저장
    match /responses/{id} {
      allow read: if true;
      allow create, update: if
        request.resource.data.keys().hasOnly(['qkey', 'voter', 'kind', 'choice', 'choices', 'word', 'text', 'ts'])
        && request.resource.data.qkey is string && request.resource.data.qkey.size() < 80
        && request.resource.data.voter is string && request.resource.data.voter.size() < 40
        && (
          (request.resource.data.kind == 'choice'
            && (
              ('choice' in request.resource.data
                && request.resource.data.choice is int
                && request.resource.data.choice >= 0 && request.resource.data.choice < 8)
              ||
              ('choices' in request.resource.data
                && request.resource.data.choices is list
                && request.resource.data.choices.size() <= 8)
            ))
          ||
          (request.resource.data.kind == 'word'
            && request.resource.data.word is string
            && request.resource.data.word.size() > 0 && request.resource.data.word.size() <= 12)
          ||
          (request.resource.data.kind == 'memo'
            && 'text' in request.resource.data
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 200)
        );
      allow delete: if false;
    }

    // 질문 목록과 현재 화면 상태: 읽기는 누구나, 쓰기는 강사 계정(구글 로그인)만
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'girinssam@gmail.com'
        && request.auth.token.email_verified == true;
    }
    match /questions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /state/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
